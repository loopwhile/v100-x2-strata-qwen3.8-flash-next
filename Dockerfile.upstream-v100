# V100-specific build of upstream Niko1221/Strata v0.1.44.1 for Stage 4-A.
# Keeps existing strata-v100-jmnargi:9d77749 and strata-v100:0.1.31 images completely separate.
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04

ARG STRATA_UPSTREAM_REF=296b59d2f73c8f04a805df29c2fa97655adace78
ARG CUDA_ARCHITECTURES=70
ARG BUILD_VISION=0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    STRATA_EXECV=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git libatomic1 libgomp1 \
      python3 python3-pip python3-venv unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/strata

RUN git init . \
    && git remote add origin https://github.com/Niko1221/Strata.git \
    && git fetch --depth 1 origin "${STRATA_UPSTREAM_REF}" \
    && git checkout --detach FETCH_HEAD \
    && git remote remove origin

RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir --upgrade pip \
    && .venv/bin/pip install --no-cache-dir -r requirements.txt \
    && chmod +x setup.sh docker-entrypoint.sh

# Keep build logic in a normal file. Docker's legacy builder on the P520 does
# not execute the upstream Dockerfile's Python heredoc correctly.
COPY docker/build_upstream_v100_engine.py /opt/strata/build_upstream_v100_engine.py

RUN CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" BUILD_VISION="${BUILD_VISION}" \
    .venv/bin/python /opt/strata/build_upstream_v100_engine.py

RUN set -eux; \
    test -x /opt/strata/engine/strata; \
    test -f /opt/strata/engine/BUILD.json; \
    ls -lah /opt/strata/engine; \
    rm -rf /opt/strata/build /opt/strata/build-vision /opt/strata/build_upstream_v100_engine.py

LABEL org.opencontainers.image.revision="${STRATA_UPSTREAM_REF}"

VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
  CMD curl -fs "http://127.0.0.1:${PORT:-8080}/health" || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]
