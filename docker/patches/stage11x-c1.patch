+                }
+            }
+        }
+    }
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const int r = (i & 2) | ((lane >> 2) & 4) | (lane & 1);
+        const int col = (i & 1) | (lane & 2) | ((i >> 2) * 4);
+        if (r < rows) Y[(size_t) (first + r) * ldy + n0 + col] = c[i];
+    }
+#endif
+}
