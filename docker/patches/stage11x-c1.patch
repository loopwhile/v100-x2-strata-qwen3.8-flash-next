+        for (int i = 0; i < n_experts; ++i)
+            if ((((uintptr_t) indirect->gu[i]) | ((uintptr_t) indirect->dn[i])) & 3u) return false;
+        return true;
+    }
+    return (reinterpret_cast<uintptr_t>(W) & 3u) == 0;
