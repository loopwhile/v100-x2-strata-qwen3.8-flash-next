+        cudaFuncAttributes attr;
+        return cudaFuncGetAttributes(&attr, fn) == cudaSuccess &&
+               attr.sharedSizeBytes <= (size_t) shm_block && attr.maxThreadsPerBlock >= W2_NT;
+    };
