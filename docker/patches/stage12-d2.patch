+bool FileExpertSource::fast_zc_ready(int64_t layer) const {
+    if (layer < 0 || layer >= n_layers_) return false;
+    return !role_ptr_.empty() && !unmapped_ && direct_.empty() && !complement_ready_ && override_.empty() &&
+           strata::kernels::cpu::expert_layout().native &&
+           strata::kernels::cpu::expert_layout().fmt[(size_t) layer].tail_off == 0;
+}
+
+bool FileExpertSource::zc_roles_fast(int64_t layer, int64_t expert, const uint8_t** p) {
+    for (int r = 0; r < 3; ++r) {
+        const size_t i = (size_t) (3 * layer + r);
+        p[r] = role_ptr_[i] + (size_t) ((uint64_t) expert * role_bytes_[i]);
+    }
+    const uint64_t bytes = layer_blob_bytes_[(size_t) layer];
+    file_read_bytes_.fetch_add(bytes, std::memory_order_relaxed);
+    reads_.fetch_add(1, std::memory_order_relaxed);
+    if (io_stats_) io_cached_.fetch_add(bytes, std::memory_order_relaxed);
+    if (gate_on_ && tl_decode) gate_c_.fetch_add(bytes, std::memory_order_relaxed);
+    return true;
+}
