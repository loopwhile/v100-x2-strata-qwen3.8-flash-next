# V100-specific Strata image.
# Pinned to Strata engine 0.1.31 and built for Volta sm_70 with CUDA 12.9.1.
# The host only needs the NVIDIA driver + NVIDIA Container Toolkit.
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04

ARG STRATA_REF=9259cad4cfa3543cd3b8decab5962672b968c649
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    STRATA_EXECV=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git libatomic1 libgomp1 \
      python3 python3-pip python3-venv unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/strata

RUN git init . \
    && git remote add origin https://github.com/Niko1221/Strata.git \
    && git fetch --depth 1 origin "${STRATA_REF}" \
    && git checkout --detach FETCH_HEAD \
    && git remote remove origin

# 0.1.31 contains the experimental Pascal/Volta CMake/runtime path, but setup.py
# still filters GPUs below sm_75 before setup can use it. Admit Volta only.
RUN python3 - <<'PY'
from pathlib import Path
p = Path("setup.py")
s = p.read_text()
old = '    if int(g["arch"]) < 75:\n'
new = '    if int(g["arch"]) < 70:\n'
if old not in s:
    raise SystemExit("expected setup.py GPU floor not found")
p.write_text(s.replace(old, new, 1))
PY

RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir --upgrade pip \
    && .venv/bin/pip install --no-cache-dir -r requirements.txt \
    && chmod +x setup.sh docker-entrypoint.sh

# Build only the text engine for V100. Vision is intentionally omitted so its
# VRAM reserve can be used by the model/expert cache.
RUN .venv/bin/python - <<'PY'
import json
import pathlib
import shutil
import setup

llama = setup.get_llama_cpp()
nvcc, version = setup.find_nvcc()
if not nvcc or not version or version[0] != 12:
    raise SystemExit(f"V100 image requires CUDA 12.x nvcc, found {nvcc} {version}")

setup.cmake_build(
    setup.ROOT,
    setup.ROOT / "build",
    "strata",
    [
        "-DSTRATA_ENABLE_CUDA=ON",
        "-DSTRATA_EXPERIMENTAL_SM60=ON",
        "-DSTRATA_BUILD_TESTS=OFF",
        "-DCMAKE_CUDA_ARCHITECTURES=70",
        f"-DCMAKE_CUDA_COMPILER={nvcc}",
        f"-DSTRATA_GGML_DIR={llama}",
    ],
    None,
    "build-strata-v100.bat",
)

eng = setup.ROOT / "engine"
eng.mkdir(exist_ok=True)
shutil.copy2(setup.ROOT / "build" / setup.EXE, eng / setup.EXE)

bindir = pathlib.Path(nvcc).parent
meta = {
    "source": "local",
    "version": setup.source_version(),
    "archs": [70],
    "vision": "none",
    "cuda_dirs": [str(d) for d in (bindir, bindir / "x64", bindir.parent / "lib64") if d.is_dir()],
    "src": setup.source_hash(setup.ENGINE_SOURCES),
    "vision_src": None,
}
(eng / "BUILD.json").write_text(json.dumps(meta, indent=1))
PY

RUN rm -rf build

VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
  CMD curl -fs "http://127.0.0.1:${PORT:-8080}/health" || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]
