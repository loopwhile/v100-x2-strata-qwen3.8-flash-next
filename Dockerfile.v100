# V100-specific Strata image.
# Pinned to Strata engine 0.1.31 and built for Volta sm_70 with CUDA 12.9.1.
# The host only needs the NVIDIA driver + NVIDIA Container Toolkit.
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04

ARG STRATA_REF=9259cad4cfa3543cd3b8decab5962672b968c649
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    STRATA_EXECV=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git libatomic1 libgomp1 \
      python3 python3-pip python3-venv unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/strata

RUN git init . \
    && git remote add origin https://github.com/Niko1221/Strata.git \
    && git fetch --depth 1 origin "${STRATA_REF}" \
    && git checkout --detach FETCH_HEAD \
    && git remote remove origin

# 0.1.31 contains the experimental Pascal/Volta CMake/runtime path, but setup.py
# still filters GPUs below sm_75 before setup can use it. Admit Volta only.
# Avoid Dockerfile RUN heredocs here: the host is using Docker's legacy builder.
RUN sed -i 's/if int(g\["arch"\]) < 75:/if int(g["arch"]) < 70:/' setup.py \
    && grep -F 'if int(g["arch"]) < 70:' setup.py

RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir --upgrade pip \
    && .venv/bin/pip install --no-cache-dir -r requirements.txt \
    && chmod +x setup.sh docker-entrypoint.sh

# Keep the build logic in a normal file rather than a Dockerfile heredoc.
# This also makes the build step's cache key include the helper's contents.
COPY docker/build_v100_engine.py /tmp/build_v100_engine.py

RUN .venv/bin/python /tmp/build_v100_engine.py

RUN set -eux; \
    test -x /opt/strata/engine/strata; \
    test -f /opt/strata/engine/BUILD.json; \
    ls -lah /opt/strata/engine; \
    rm -rf /opt/strata/build /tmp/build_v100_engine.py

VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
  CMD curl -fs "http://127.0.0.1:${PORT:-8080}/health" || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]
